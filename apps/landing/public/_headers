# Response headers for doriterm.com when dist/ is served as Workers static assets (the file itself is never served).

/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; frame-src 'self'; connect-src 'self' https://get.doriterm.com; base-uri 'none'; form-action 'none'; frame-ancestors 'self'

# Hashed build output never changes in place.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The social card is linked by absolute URL from other sites, so its name stays fixed.
/og.png
  ! Cache-Control
  Cache-Control: public, max-age=86400
