// doriterm.com: this package's build (dist/, `bun run build`) served as Workers static assets, with no Worker code.
// .github/workflows/deploy-landing.yml deploys staging (staging.doriterm.com), probes it, and deploys production
// (doriterm.com) from a manual run once app.doriterm.com answers. Self-hosters: put your own hostnames in "routes".
{
  "name": "doriterm-landing",
  "compatibility_date": "2026-11-06",
  // auto-trailing-slash serves the mockup's folder index (mockup/index.html) at /mockup/ with no redirect (/mockup
  // without the slash redirects to it); the page and the probe therefore use /mockup/.
  "assets": { "directory": "./dist", "html_handling": "auto-trailing-slash" },
  "workers_dev": false,
  "preview_urls": false,
  // zone_id lets a Workers-only API token attach the custom domains without zone listing rights.
  "routes": [
    { "pattern": "doriterm.com", "custom_domain": true, "zone_id": "79ae74d5937b2858a42f6261887e436e" },
    { "pattern": "www.doriterm.com", "custom_domain": true, "zone_id": "79ae74d5937b2858a42f6261887e436e" },
  ],
  "env": {
    "staging": {
      "name": "doriterm-landing-staging",
      "assets": { "directory": "./dist", "html_handling": "auto-trailing-slash" },
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "staging.doriterm.com", "custom_domain": true, "zone_id": "79ae74d5937b2858a42f6261887e436e" },
      ],
    },
  },
}
