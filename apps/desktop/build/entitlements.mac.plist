<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 in Electron and JavaScriptCore in the bun-compiled host (Resources/bin) both JIT under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Dictation (#726): the hardened runtime refuses audio input without it; macOS still asks the user first. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
