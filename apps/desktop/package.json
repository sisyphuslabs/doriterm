{
  "name": "@doriface/desktop",
  "version": "0.1.19",
  "private": true,
  "description": "Doriterm desktop shell",
  "homepage": "https://github.com/sisyphuslabs/doriterm",
  "license": "AGPL-3.0-only",
  "author": "Sisyphus Labs",
  "type": "module",
  "main": "dist/app/main.js",
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:host": "bun scripts/build-host.ts",
    "build:web": "bun run --cwd ../web build",
    "start": "bun run build:web && bun run build && electron .",
    "dev": "bun scripts/dev.ts",
    "pack": "bun run build:web && bun run build && bun run build:host && electron-builder --dir",
    "dist": "bun run build:web && bun run build && bun run build:host all && electron-builder",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@doriface/crypto": "workspace:*",
    "@doriface/host": "workspace:*",
    "@doriface/protocol": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "node-api-headers": "1.9.0",
    "ws": "8.18.3"
  },
  "productName": "Doriterm"
}
