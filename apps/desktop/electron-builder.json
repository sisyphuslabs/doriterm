{
  "$schema": "../../node_modules/app-builder-lib/scheme.json",
  "appId": "dev.omo.doriface",
  "productName": "Doriterm",
  "executableName": "Doriterm",
  "electronVersion": "45.2.1",
  "toolsets": { "appimage": "1.0.3" },
  "directories": { "output": "dist/release", "buildResources": "build" },
  "files": ["dist/app/**", "package.json"],
  "extraResources": [
    { "from": "../web/dist", "to": "web" },
    { "from": "dist/host/${os}-${arch}", "to": "bin" }
  ],
  "asar": true,
  "npmRebuild": false,
  "forceCodeSigning": false,
  "afterSign": "./scripts/notarize-mac.mjs",
  "publish": [{ "provider": "generic", "url": "https://get.doriterm.com/desktop/stable" }],
  "detectUpdateChannel": false,
  "protocols": [{ "name": "Doriterm link", "schemes": ["doriface"] }],
  "mac": {
    "category": "public.app-category.developer-tools",
    "icon": "build/icon.icns",
    "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
    "hardenedRuntime": true,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "extraResources": [{ "from": "dist/native", "to": "native", "filter": ["speech.node"] }],
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Doriterm listens only while you dictate into a terminal. macOS recognizes your speech on this Mac; the audio never leaves it.",
      "NSSpeechRecognitionUsageDescription": "Doriterm turns what you dictate into text with macOS's on-device speech recognition. The audio never leaves this Mac."
    },
    "notarize": false,
    "target": [
      { "target": "dmg", "arch": ["arm64", "x64"] },
      { "target": "zip", "arch": ["arm64", "x64"] }
    ]
  },
  "dmg": { "artifactName": "${productName}-${version}-${arch}.${ext}", "sign": true },
  "win": {
    "icon": "build/icon.ico",
    "extraResources": [{ "from": "dist/native", "to": "native", "filter": ["speech.node"] }],
    "target": [{ "target": "nsis", "arch": ["x64", "arm64"] }]
  },
  "nsis": { "artifactName": "${productName}-${version}-${arch}-setup.${ext}", "include": "build/installer.nsh" },
  "linux": {
    "category": "Development",
    "icon": "build/icon.png",
    "maintainer": "Sisyphus Labs",
    "target": [
      { "target": "AppImage", "arch": ["x64", "arm64"] },
      { "target": "deb", "arch": ["x64", "arm64"] }
    ]
  },
  "appImage": { "artifactName": "${productName}-${version}-${arch}.${ext}", "executableArgs": ["--no-sandbox"] },
  "deb": { "artifactName": "${productName}_${version}_${arch}.${ext}" }
}
