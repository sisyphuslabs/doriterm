{
  "name": "doriface",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/relay"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "gen:api:check": "bun run --cwd packages/protocol gen:api:check",
    "test": "bun apps/host/scripts/test-run.ts && bun tests/relay/private-relay.ts notice",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run gen:api:check && bun run test",
    "relay:fetch": "bun tests/relay/private-relay.ts fetch",
    "relay:test": "bun tests/relay/private-relay.ts test",
    "relay:dev": "bun tests/relay/private-relay.ts dev",
    "capture:readme": "bun run --cwd apps/web capture:readme",
    "bench:render": "bun run --cwd apps/web bench:render"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@wterm/dom@0.5.9": "patches/@wterm%2Fdom@0.5.9.patch",
    "@wterm/ghostty@0.5.9": "patches/@wterm%2Fghostty@0.5.9.patch"
  }
}
