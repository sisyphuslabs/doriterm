+/// The root record of the OSC 7501 Program Status Protocol. Records with an
+/// id are children owned by the program and are not tracked here.
+const ProgramStatusState = struct {
+    const APP_MAX_BYTES = 64;
+    state: i32 = -1,
+    progress: i32 = -1,
+    app: [APP_MAX_BYTES]u8 = undefined,
+    app_len: u8 = 0,
+
+    fn apply(self: *ProgramStatusState, report: ProgramStatusReport) void {
+        if (report.state == .clear) {
+            if (report.readOption(.id) == null) self.* = .{};
+            return;
+        }
+        if (report.readOption(.id) != null) return;
+        self.state = @intFromEnum(report.state);
+        self.progress = if (report.readOption(.progress)) |value| value else -1;
+        const app = report.readOption(.app) orelse "";
+        const len = @min(app.len, APP_MAX_BYTES);
+        @memcpy(self.app[0..len], app[0..len]);
+        self.app_len = @intCast(len);
+    }
+};
